#include <iostream>
#include <string>
using namespace std;

string input;
int pos = 0;

bool match(string s) {
    if (input.substr(pos, s.length()) == s) {
        pos += s.length();
        return true;
    }
    return false;
}

bool Factor() {
    return match("id");
}

bool Term() {
    if (!Factor())
        return false;

    while (true) {
        int save = pos;

        if (match(" ")) {
            // skip spaces
        }

        if (match("*")) {
            if (!match(" "))
                return false;

            if (!Factor())
                return false;
        } else {
            pos = save;
            break;
        }
    }

    return true;
}

bool Expression() {
    if (!Term())
        return false;

    while (true) {
        int save = pos;

        if (match(" ")) {
            // skip spaces
        }

        if (match("+")) {
            if (!match(" "))
                return false;

            if (!Term())
                return false;
        } else {
            pos = save;
            break;
        }
    }

    return true;
}

int main() {
    input = "id + id * id";

    if (Expression() && pos == input.length())
        cout << "Input Accepted";
    else
        cout << "Input Rejected";

    return 0;
